    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.104.3",
    "axios": "^1.15.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "framer-motion": "^13.2.0",
    "fzstd": "^0.1.1",
    "highlight.js": "^11.11.1",
    "i18next": "^26.4.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.57.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
