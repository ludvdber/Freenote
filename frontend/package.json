    "@tanstack/react-query": "^5.105.3",
    "axios": "^1.21.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "framer-motion": "^13.2.0",
    "fzstd": "^0.1.1",
    "highlight.js": "^11.11.1",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.67.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.5",
