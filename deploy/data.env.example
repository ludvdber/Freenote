# Secrets for the Docker data services (docker-compose.prod.yml).
# Place at /opt/freenote/.env  (same dir as docker-compose.yml), chmod 600.
# docker compose auto-loads a file named `.env` from the project directory.
# Do NOT commit the populated version.
#
# ⚠️ These MUST match the app env file /etc/freenote/freenote.env:
#     POSTGRES_USER     -> DB_USERNAME
#     POSTGRES_PASSWORD -> DB_PASSWORD
#     MINIO_ROOT_USER     -> MINIO_ACCESS_KEY
#     MINIO_ROOT_PASSWORD -> MINIO_SECRET_KEY
#     MEILI_MASTER_KEY    -> MEILISEARCH_API_KEY

# --- Postgres ---
POSTGRES_USER=freenote
# openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# --- MinIO (object storage) ---
# Access key = root user, secret = root password (≥ 8 chars; use a long random secret).
MINIO_ROOT_USER=freenote
# openssl rand -base64 32
MINIO_ROOT_PASSWORD=change-me

# --- Meilisearch ---
# openssl rand -base64 32   (Meilisearch requires a master key ≥ 16 bytes in production)
MEILI_MASTER_KEY=change-me
