# Production environment for the Freenote backend.
# Place at /etc/freenote/freenote.env, chmod 600, chown freenote:freenote.
# Do NOT commit the populated version to git.
#
# Topology = single Proxmox LXC: the 4 data services run in Docker on THIS host
# (deploy/docker-compose.prod.yml, ports bound to 127.0.0.1), the app reaches them over
# loopback. The values below MUST match deploy/data.env.example (the Docker .env):
#   DB_USERNAME/DB_PASSWORD == POSTGRES_USER/POSTGRES_PASSWORD
#   MINIO_ACCESS_KEY/MINIO_SECRET_KEY == MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
#   MEILISEARCH_API_KEY == MEILI_MASTER_KEY

# --- Database (Postgres in local Docker) ---
DB_URL=jdbc:postgresql://127.0.0.1:5432/freenote
DB_USERNAME=freenote
DB_PASSWORD=change-me

# --- Redis (local Docker) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- MinIO (object storage, local Docker) ---
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=freenote-docs

# --- Meilisearch (search, local Docker) ---
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=change-me

# --- SMTP (school email verification) — Brevo recommended (300/day free, Paris-hosted) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
# From address for verification emails. MUST be on the domain authenticated at Brevo
# (SPF/DKIM) or mails land in spam.
MAIL_FROM=noreply@freenote.be

# --- OAuth2 Discord (only provider) ---
DISCORD_CLIENT_ID=change-me
DISCORD_CLIENT_SECRET=change-me

# --- Discord bot ("verified" role) — SAME Discord app as the OAuth login, different credential ---
# Blank = disabled (no Discord call). Bot Token: Developer Portal → your app → Bot → Reset Token.
# Invite the bot on the server (scope `bot` + Manage Roles); its role must sit ABOVE the verified role.
DISCORD_BOT_TOKEN=change-me
DISCORD_GUILD_ID=change-me
DISCORD_VERIFIED_ROLE_ID=change-me
# Channel for the hourly "new verified documents" digest (bot needs View Channel + Send Messages).
# Blank = no announcements.
DISCORD_ANNOUNCE_CHANNEL_ID=change-me

# --- JWT ---
# Generate with: openssl rand -base64 96 | tr -d '\n'
# Must be at least 64 bytes (HS512 requirement).
JWT_SECRET=change-me-to-a-96-byte-base64-string

# --- Email hashing salt (used for privacy-preserving email lookups) ---
# Generate with: openssl rand -base64 32
EMAIL_HASH_SALT=change-me

# --- Frontend URL (used for OAuth2 redirect_uri + CORS) ---
FRONTEND_URL=https://freenote.be

# --- CORS allowed origins (comma-separated) ---
CORS_ALLOWED_ORIGINS=https://freenote.be

# --- Cookie + proxy (nginx in front) ---
# The backend is served over HTTP inside the Proxmox private network;
# nginx terminates TLS and forwards with X-Forwarded-Proto=https.
# Keep Secure=true so cookies require HTTPS on the client side.
COOKIE_SECURE=true
# CIDR of the reverse proxy whose X-Forwarded-For the backend trusts. This is the IP the
# backend SEES connecting to it — i.e. the reverse proxy, NOT Cloudflare (Cloudflare is
# handled by the proxy's own real_ip block, never reaches the backend directly).
#   - Reverse proxy in the SAME LXC as the app   → 127.0.0.1/32
#   - Reverse proxy on a SEPARATE LXC/host (a shared nginx) → that proxy LXC's IP, e.g.
#     10.0.0.2/32. NOT 127.0.0.1/32, or the backend distrusts X-Forwarded-For and per-IP
#     rate-limiting breaks (every request looks like it comes from the proxy).
TRUSTED_PROXIES=127.0.0.1/32

# --- Ko-fi webhook verification token (set on Ko-fi dashboard) ---
KOFI_VERIFICATION_TOKEN=change-me

# --- Server port (match the systemd unit + nginx upstream) ---
SERVER_PORT=8080

# --- Sentry (optional, for production error tracking) ---
# Leave unset to disable. When set, add `io.sentry:sentry-spring-boot-starter-jakarta`
# to build.gradle.kts once Sentry officially supports Spring Boot 4.
SENTRY_DSN=
SENTRY_ENV=prod
