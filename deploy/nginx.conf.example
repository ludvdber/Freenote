# Freenote vhost — drops into your EXISTING shared nginx LXC (the same nginx that already serves
# your other sites). It is NOT a dedicated nginx and does NOT replace anything: add it as a new
# site. (Real IPs/VMIDs of this deployment live in deploy/values.local.md, outside git.)
#
#   cp deploy/nginx.conf.example  /etc/nginx/sites-available/freenote.be   (on the nginx LXC)
#   ln -s /etc/nginx/sites-available/freenote.be /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# ⚠️ THE DEPLOYED VHOST CAN DRIFT FROM THIS FILE — and a missing real_ip block silently breaks the
# backend's per-IP rate limiting (every anonymous visitor would share ~20 Cloudflare IPs). Note
# that `real_ip_header` alone does NOTHING without `set_real_ip_from`: nginx trusts no proxy by
# default. Check the live vhost rather than assuming:
#     grep -c real_ip_header   /etc/nginx/sites-enabled/freenote.be   # must be 1
#     grep -c set_real_ip_from /etc/nginx/sites-enabled/freenote.be   # must be ~22, not 0
#     grep -E "GET /(api|browse)" /var/log/nginx/access.log | tail -3 # $remote_addr = REAL visitor IP
# (Checked OK on 2026-09-08: real visitor IPs. Only 15 of the 22 CIDRs were present, i.e. IPv4
#  only — harmless while nginx has no IPv6 listener, but keep the list synced with
#  https://www.cloudflare.com/ips/.)
#
# ── Log format: declare ONCE in the http{} context, not here ──────────────────────────────
# `log_format` is only valid inside http{}, so it cannot live in the server{} blocks below.
# Put this in /etc/nginx/conf.d/freenote-log.conf (conf.d is included from http{}):
#
#     log_format vhost '$remote_addr - $host [$time_local] "$request" '
#                      '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
#                      'rt=$request_time us=$upstream_status';
#
# $host matters: this shared nginx pours every site into one access.log, so without it a
# Freenote-only post-mortem is impossible (you cannot tell freenote.be requests apart from the
# other vhosts'). The server{} below then writes its own file with that format.
#
# ── Topology: Cloudflare → nginx (shared LXC) → Freenote app LXC (<APP_LXC_IP>:8080) ──
# Cloudflare terminates TLS at the edge and connects to this nginx from *its own* IPs, so the
# real_ip block (inside the server{} below) rewrites $remote_addr to the true visitor IP via
# CF-Connecting-IP. Without it every request looks like ~20 Cloudflare IPs → the backend's
# per-IP rate limiting breaks and access logs are wrong. The block is scoped to THIS server{}
# so the other vhosts on the shared nginx LXC are untouched.
# On the backend side, TRUSTED_PROXIES must be THIS nginx's IP — the app only ever sees nginx
# as its immediate proxy, never Cloudflare.
#
# ── TLS / certificate (the A record is Cloudflare-proxied 🟠) ──────────────────────────────
# certbot's HTTP-01 challenge does NOT work while the record is proxied (Cloudflare intercepts
# :80). Pick ONE:
#   (A) RECOMMENDED — Cloudflare Origin Certificate (15-year, no renewal): Cloudflare dashboard
#       → SSL/TLS → Origin Server → Create Certificate. Save cert+key on the nginx LXC and point the
#       ssl_certificate(_key) below at them. Works with SSL mode "Full (strict)".
#   (B) Let's Encrypt: temporarily set the freenote.be A record to "DNS only" ⚪, run
#       `certbot --nginx -d freenote.be -d www.freenote.be`, then flip it back to Proxied 🟠.
#       (Or use certbot's DNS-01 Cloudflare plugin to keep it proxied throughout.)
# ──────────────────────────────────────────────────────────────────────────────────────────

upstream freenote_backend {
    server 10.0.0.10:8080;   # ← IP of the Freenote app LXC (see deploy/values.local.md)
    keepalive 32;
}

# HTTP → HTTPS (Cloudflare "Always Use HTTPS" usually handles this at the edge; kept for safety).
server {
    listen 80;
    server_name freenote.be www.freenote.be;
    return 301 https://freenote.be$request_uri;
}

# Canonical host redirect: www → apex (301).
server {
    listen 443 ssl http2;
    server_name www.freenote.be;

    ssl_certificate     /etc/ssl/cloudflare/freenote.be.pem;     # or /etc/letsencrypt/live/freenote.be/fullchain.pem
    ssl_certificate_key /etc/ssl/cloudflare/freenote.be.key;     # or /etc/letsencrypt/live/freenote.be/privkey.pem
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 301 https://freenote.be$request_uri;
}

server {
    listen 443 ssl http2;
    server_name freenote.be;

    # TLS — Cloudflare Origin Cert (recommended) or Let's Encrypt; see header.
    ssl_certificate     /etc/ssl/cloudflare/freenote.be.pem;
    ssl_certificate_key /etc/ssl/cloudflare/freenote.be.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # --- real_ip: restore the true client IP from Cloudflare (scoped to this vhost) ---
    # Keep this CIDR list synced with https://www.cloudflare.com/ips/ (v4 + v6).
    real_ip_header CF-Connecting-IP;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;

    # Own access log, in the `vhost` format declared in http{} (see the header of this file).
    # Without it Freenote's traffic is mixed into the shared access.log of every other site.
    access_log /var/log/nginx/freenote.access.log vhost;
    error_log  /var/log/nginx/freenote.error.log;

    # Upload cap: must sit just above Spring's spring.servlet.multipart.max-request-size = 50MB
    # (one request can carry up to 8 images for the image→PDF feature; each part is separately
    # capped at max-file-size = 8MB). It used to be 12M here, which would have 413'd any
    # multi-image upload at the proxy before Spring ever saw it.
    client_max_body_size 52M;

    # Security headers complementing the CSP Spring already emits.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=()" always;

    # Compression — Spring Boot already enables gzip but nginx does it better for static assets.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Server-Sent Events stream for live notifications. Buffering MUST be off or nginx
    # holds each event back and the feed only flushes when the connection closes.
    location /api/notifications/stream {
        proxy_pass http://freenote_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Connection "";   # keep-alive upstream, no "upgrade" for SSE
        proxy_buffering off;              # flush events immediately
        proxy_cache off;
        chunked_transfer_encoding off;
        # The server closes the stream after 30 min; allow a little more before nginx gives up.
        proxy_read_timeout 35m;
    }

    location / {
        proxy_pass http://freenote_backend;
        proxy_http_version 1.1;

        # The Spring backend reads X-Forwarded-* via server.forward-headers-strategy=NATIVE.
        # TRUSTED_PROXIES (backend env) must equal this nginx's IP.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Static Vite assets are hashed; the backend already sends `Cache-Control: immutable`
    # (SpaForwardingConfig), so nginx just proxies — no add_header here (avoids a duplicate header).
    location /assets/ {
        proxy_pass http://freenote_backend;
        proxy_set_header Host $host;
    }
}
