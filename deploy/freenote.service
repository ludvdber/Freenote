[Unit]
Description=Freenote backend (Spring Boot + embedded SPA)
Documentation=https://github.com/ludvdber/Freenote
# The 4 data services (postgres, redis, minio, meilisearch) run in Docker on THIS same LXC.
# Start after the network AND the Docker daemon. Note: docker.service being "active" does NOT
# mean Postgres already accepts connections — ExecStartPre below polls pg_isready first, so the
# JVM never boots against a cold DB (Flyway/Hibernate would fail fast otherwise).
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=freenote
Group=freenote
WorkingDirectory=/opt/freenote
# All secrets and service URLs come from /etc/freenote/freenote.env (chmod 600, owner freenote).
# Example variables: DB_URL, JWT_SECRET, MINIO_ACCESS_KEY, MEILISEARCH_API_KEY, etc.
# See deploy/freenote.env.example for the full list.
EnvironmentFile=/etc/freenote/freenote.env

# Wait (max ~120s) for the Postgres container to accept connections before launching the app.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do pg_isready -h 127.0.0.1 -p 5432 && exit 0; sleep 2; done; echo "postgres still not ready after 120s"; exit 1'

# Java 25: Debian 13 (Trixie) ships openjdk-25 natively (apt install openjdk-25-jre-headless),
# so /usr/bin/java IS Java 25 — no third-party repo needed (the Adoptium repo is broken on Trixie).
#
# Memory sizing (revised 2026-09-08 after an 18 h freeze of the LXC, see docs/INFRA-SETUP.md §16):
#   -Xmx2g          FIXED heap, not a percentage. The previous -XX:MaxRAMPercentage=50 let the JVM
#                   claim 4 GB of heap in an 8 GB LXC it SHARES with 4 Docker containers. The app's
#                   live set is far below 2 GB (RSS dropped 1.9 GB -> 0.9 GB after this change).
#   -XX:+UseG1GC    G1, not ZGC: ZGC targets multi-tens-of-GB heaps and reserves a lot of off-heap
#                   metadata for nothing at this scale. Sub-millisecond pauses buy us nothing here.
#   ExitOnOutOfMemoryError  die cleanly so systemd restarts us (5 s) instead of GC-thrashing and
#                   dragging the whole container into swap.
#   HeapDump*       so a future OOM names the culprit instead of leaving us guessing.
ExecStart=/usr/bin/java \
    -Xmx2g \
    -XX:+UseG1GC \
    -XX:+ExitOnOutOfMemoryError \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/opt/freenote/logs \
    -Dspring.profiles.active=prod \
    -jar /opt/freenote/freenote.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

# Hard ceiling on the whole service cgroup — the belt to -Xmx's braces. If the JVM ever overruns
# (heap + metaspace + thread stacks + native), IT gets OOM-killed inside ITS OWN cgroup and systemd
# restarts it in 5 s. Without this, the overrun is absorbed by the LXC's cgroup instead, where
# Proxmox sets memory.high 64 MiB below memory.max: the kernel then THROTTLES every allocation
# without ever killing anything (oom_kill stays 0) and the container freezes for hours. That is
# exactly what happened on 2026-09-07.
MemoryMax=3G

# Graceful shutdown: Spring Boot default is 30s — match it so systemd doesn't SIGKILL first.
TimeoutStopSec=35

# Hardening — reasonable defaults for an LXC where the service is the only tenant.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/freenote/logs /var/log/freenote

# Log to journald (view with: journalctl -u freenote -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
