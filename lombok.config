# Racine du projet : ne pas remonter chercher une autre config.
config.stopBubbling = true

# Marque tout le code généré par Lombok d'un @lombok.Generated, que JaCoCo ignore d'office.
# Sans ça, les getters/setters/builders/equals des entités et DTO gonflent le dénominateur de
# couverture avec du code que personne n'a écrit — le pourcentage cesse de vouloir dire quoi que ce soit.
lombok.addLombokGeneratedAnnotation = true
